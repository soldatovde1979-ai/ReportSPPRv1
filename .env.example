# .env.example — образец файла .env для локального запуска RepSSPR.ipynb (ноутбук 6.2, my-FT Т-99, В-25)
# Как пользоваться: скопировать в .env (в той же папке проекта) и раскомментировать нужные строки (убрать «# »).
# .env в git не попадает (.gitignore) — ключи храните только там. Строка без значения или закомментированная —
# берётся значение по умолчанию из ноутбука. Какие параметры взяты из .env — ноутбук пишет в выводе строкой «⚙️ Параметр из .env».

# --- Параметры прогона ---
# REPORT_WEEK=41            # номер ISO-недели отчёта; 0 — последняя завершённая неделя выгрузки
# AI_PROVIDER=auto          # auto (локально — opencoder) | opencoder | deepseek | google
# REUSE_AI=1                # 1 — ответы ИИ из кэша для той же выгрузки (бесплатный повтор); 0 — спросить заново
# TEST_SAMPLE_SIZE=0        # >0 — пробный прогон на N обращениях, история недель не пишется
# IS_DEBUG=0                # 1 — лог запуска в result/logs/Logs.csv и Token.csv
# AI_STUB=0                 # заглушка ИИ (ноутбук 6.5): 0 выкл; 1 пусто; 2 промпт блока; 3 текст готового отчёта W41 — без вызовов модели
# OC_BASE_URL=http://127.0.0.1:8787/v1   # адрес локального прокси OpenCoder

# --- Ключи (нужны только для deepseek или google) ---
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
