# Кэш Python: создаётся при импорте src/report_v<МАЖОР>.py (сборка макета, сверки) — в репозиторий не кладём
__pycache__/
# Ключи API для локального запуска (my-FT В-25): только на своём компьютере, в репозиторий — никогда
.env
# Рабочая копия ноутбука для локального запуска (run_local.bat): Jupyter пишет в неё вывод — RepSSPR.ipynb остаётся чистым
run/
