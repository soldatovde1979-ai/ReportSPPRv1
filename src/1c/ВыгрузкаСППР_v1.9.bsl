// ВыгрузкаСППР v1.9 (13.10.2026) — выгрузка обращений СППР в JSON для ReportSPPR.
// v1.9: поле ksr — крайний срок решения (Идеи.шхКрайнийСрокРешения); используется для ЗИ и
//       инцидентов; в выгрузку ЗИ не попадают (отбор «Поддержка»), поэтому заполнен у инцидентов.
//       Пустая дата — пустая строка. Постановка — src/vygruzka-1c.md, п. 2.9.
//       Постановка v1.8 (поле name, без cli_id) в ЭТОЙ функции не выполнена — переносится.
// v1.7: url — внешняя ссылка: адрес публикации ИБ в локальной сети + "#" + навигационная ссылка
//       (как в функции ПолучитьВнешнююСсылку; адрес публикации берётся один раз на выгрузку).
// v1.6: псевдоним ЧасыФакт → ЧасыПоКарточкам в tab_trud (совпадал с именем ресурса — «Неоднозначное поле»).
// Постановка — src/vygruzka-1c.md; поля JSON — docs/data.md, разд. 2 и 10.
// v1.5: необязательные поля url, cli_id, anl_id, parent и табличные части tab_trud, tab_status,
//       tab_sla, tab_rate, tab_chat (переписка — только при ВыгружатьПереписку = Истина).
//       Отбор обращений — как в v1.4; части по каждому обращению — целиком, без отсечки по дате.
// Внешняя зависимость: ОчиститьТекстRegExp(Текст, RegExp) — существующая функция модуля.

// === ВЫГРУЗКА 1: ИДЕИ ===

&НаСервереБезКонтекста
Функция ДатаВJSON(Знач ЗначениеДаты)
	Если Не ЗначениеЗаполнено(ЗначениеДаты) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Формат(ЗначениеДаты, "ДФ=yyyy-MM-dd") + "T" + Формат(ЗначениеДаты, "ДФ=HH:mm:ss");
КонецФункции

&НаСервереБезКонтекста
// ----------------------------------------------------------------------
// ЧТО ИЗМЕНЕНО: необязательный параметр ВыгружатьПереписку (по умолчанию Ложь)
// ПОЧЕМУ: переписку берём для информации (my-FT Т-75); старые вызовы работают без правки
// ----------------------------------------------------------------------
Функция СформироватьJSONНаСервере(Знач ДатаГраницы, Знач ДатаГраницыКонец, Знач ВыгружатьПереписку = Ложь)
	Если Не ЗначениеЗаполнено(ДатаГраницы) Тогда
		ДатаГраницы = НачалоДня(ТекущаяДата());
	Иначе
		Если Год(ДатаГраницы) <= 2000 Тогда
			ДатаГраницы = Дата(Год(ТекущаяДата()), Месяц(ДатаГраницы), День(ДатаГраницы));
		КонецЕсли;
		ДатаГраницы = НачалоДня(ДатаГраницы);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаГраницыКонец) Тогда
		ДатаГраницыКонец = Дата(2050, 1, 1);
	Иначе
		ДатаГраницыКонец = КонецДня(ДатаГраницыКонец);
	КонецЕсли;

	Запрос = Новый Запрос;
	// ----------------------------------------------------------------------
	// ЧТО ИЗМЕНЕНО: менеджер временных таблиц
	// ПОЧЕМУ: табличные части собираются вторым пакетом по ВтИдеи
	// ----------------------------------------------------------------------
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	СписокЗИ = Новый СписокЗначений;
	СписокЗИ.Добавить(Справочники.Цели.ПолучитьСсылку(Новый УникальныйИдентификатор("47061FD8-767C-11ED-A316-005056B64C73")));
	СписокЗИ.Добавить(Справочники.Цели.ПолучитьСсылку(Новый УникальныйИдентификатор("20E153DA-7221-11ED-A316-005056B64C73")));
	СписокЗИ.Добавить(Справочники.Цели.ПолучитьСсылку(Новый УникальныйИдентификатор("157F5A89-A955-11ED-A31A-005056B64C73")));

	// ЧТО ИЗМЕНЕНО: убран параметр ДатаОткрытыхОт
	// ПОЧЕМУ: открытые берутся все, отсечка по году архива больше не нужна
	Запрос.УстановитьПараметр("ОтношениеТребованийКЦелямПроектаЗИ", СписокЗИ);
	Запрос.УстановитьПараметр("ДатаЗакрытия", ДатаГраницы);
	Запрос.УстановитьПараметр("ДатаЗакрытияКонец", ДатаГраницыКонец);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Идеи.Ссылка КАК Требование,
	|	МАКСИМУМ(Карточка.Ссылка) КАК Карточка
	|ПОМЕСТИТЬ ВтИдеи
	|ИЗ
	|	Справочник.Идеи КАК Идеи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСценариевТребованиям КАК СоответствиеСценариевТребованиям
	|		ПО Идеи.Ссылка = СоответствиеСценариевТребованиям.Требование
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Карточка КАК Карточка
	|		ПО Идеи.Ссылка = Карточка.Предмет
	|ГДЕ
	|	НЕ Идеи.ОтношениеТребованийКЦелямПроекта В (&ОтношениеТребованийКЦелямПроектаЗИ)
	|	И Идеи.т1кПринадлежность = ЗНАЧЕНИЕ(Перечисление.т1кПринадлежность.Поддержка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Идеи.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Карточка,
	|	Требование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// Даты по КАРТОЧКЕ: дата ""Выполнено"" и дата последней записи
	|ВЫБРАТЬ
	|	ВтИдеи.Требование КАК Требование,
	|	МАКСИМУМ(ИсторияСтатусовКарточек.Период) КАК ДатаПоследнего,
	|	МАКСИМУМ(ВЫБОР КОГДА ИсторияСтатусовКарточек.Статус.Наименование = ""Выполнено""
	|			ТОГДА ИсторияСтатусовКарточек.Период ИНАЧЕ NULL КОНЕЦ) КАК ДатаВыполнено
	|ПОМЕСТИТЬ ВтДатыКарточки
	|ИЗ
	|	ВтИдеи КАК ВтИдеи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияСтатусовКарточек КАК ИсторияСтатусовКарточек
	|		ПО ВтИдеи.Карточка = ИсторияСтатусовКарточек.Карточка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтИдеи.Требование
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Требование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// Статус КАРТОЧКИ на последнюю дату — нужен для открытых обращений
	|ВЫБРАТЬ
	|	ВтДатыКарточки.Требование КАК Требование,
	|	МАКСИМУМ(ИсторияСтатусовКарточек.Статус.Наименование) КАК СтатусКарточки
	|ПОМЕСТИТЬ ВтСтатусКарточки
	|ИЗ
	|	ВтДатыКарточки КАК ВтДатыКарточки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтИдеи КАК ВтИдеи
	|		ПО ВтДатыКарточки.Требование = ВтИдеи.Требование
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияСтатусовКарточек КАК ИсторияСтатусовКарточек
	|		ПО (ВтИдеи.Карточка = ИсторияСтатусовКарточек.Карточка)
	|			И ВтДатыКарточки.ДатаПоследнего = ИсторияСтатусовКарточек.Период
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтДатыКарточки.Требование
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Требование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// ЧТО ИЗМЕНЕНО: даты статусов требования берутся из ИсторияИзмененияТребований,
	|//               сравнение через ЗНАЧЕНИЕ(Перечисление.СтатусыТребования...)
	|// ПОЧЕМУ: ""Отработано"", ""Закрыто"" и ""Отклонено"" — статусы требования, лежат
	|//         в отдельном регистре; СтатусОбработкиТребований — перечисление
	|ВЫБРАТЬ
	|	ИсторияИзмененияТребований.Идея КАК Требование,
	|	МАКСИМУМ(ИсторияИзмененияТребований.Период) КАК ДатаПоследнего,
	|	МАКСИМУМ(ВЫБОР КОГДА ИсторияИзмененияТребований.СтатусОбработкиТребований = ЗНАЧЕНИЕ(Перечисление.СтатусыТребования.Отработано)
	|			ТОГДА ИсторияИзмененияТребований.Период ИНАЧЕ NULL КОНЕЦ) КАК ДатаРешения,
	|	МАКСИМУМ(ВЫБОР КОГДА ИсторияИзмененияТребований.СтатусОбработкиТребований = ЗНАЧЕНИЕ(Перечисление.СтатусыТребования.Закрыто)
	|			ТОГДА ИсторияИзмененияТребований.Период ИНАЧЕ NULL КОНЕЦ) КАК ДатаЗакрытия,
	|	МАКСИМУМ(ВЫБОР КОГДА ИсторияИзмененияТребований.СтатусОбработкиТребований = ЗНАЧЕНИЕ(Перечисление.СтатусыТребования.Отклонено)
	|			ТОГДА ИсторияИзмененияТребований.Период ИНАЧЕ NULL КОНЕЦ) КАК ДатаОтклонения
	|ПОМЕСТИТЬ ВтДатыТребования
	|ИЗ
	|	ВтИдеи КАК ВтИдеи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияИзмененияТребований КАК ИсторияИзмененияТребований
	|		ПО ВтИдеи.Требование = ИсторияИзмененияТребований.Идея
	|
	|СГРУППИРОВАТЬ ПО
	|	ИсторияИзмененияТребований.Идея
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Требование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// Текущий статус и тип требования на последнюю дату регистра
	|ВЫБРАТЬ
	|	ВтДатыТребования.Требование КАК Требование,
	|	МАКСИМУМ(ИсторияИзмененияТребований.СтатусОбработкиТребований) КАК СтатусТребования,
	|	МАКСИМУМ(ИсторияИзмененияТребований.ТипТребования) КАК ТипТребования,
	|	МАКСИМУМ(ВтДатыТребования.ДатаРешения) КАК ДатаРешения,
	|	МАКСИМУМ(ВтДатыТребования.ДатаЗакрытия) КАК ДатаЗакрытия,
	|	МАКСИМУМ(ВтДатыТребования.ДатаОтклонения) КАК ДатаОтклонения
	|ПОМЕСТИТЬ ВтСтатусТребования
	|ИЗ
	|	ВтДатыТребования КАК ВтДатыТребования
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияИзмененияТребований КАК ИсторияИзмененияТребований
	|		ПО ВтДатыТребования.Требование = ИсторияИзмененияТребований.Идея
	|			И ВтДатыТребования.ДатаПоследнего = ИсторияИзмененияТребований.Период
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтДатыТребования.Требование
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Требование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// ЧТО ИЗМЕНЕНО: Добавлена выборка трудозатрат по карточке
	|// ПОЧЕМУ: Необходима выгрузка поля AmountTrud
	|ВЫБРАТЬ
	|	ВтИдеи.Требование КАК Требование,
	|	СУММА(ЧасыФактПоКарточкам.ЧасыФакт) КАК Трудозатраты
	|ПОМЕСТИТЬ ВтТрудозатраты
	|ИЗ
	|	ВтИдеи КАК ВтИдеи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЧасыФактПоКарточкам КАК ЧасыФактПоКарточкам
	|		ПО ВтИдеи.Карточка = ЧасыФактПоКарточкам.Карточка
	|СГРУППИРОВАТЬ ПО
	|	ВтИдеи.Требование
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Требование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ВтСтатусКарточки.СтатусКарточки = ""Выполнено""
	|			ТОГДА ВЫБОР
	|					КОГДА ВтСтатусТребования.СтатусТребования = ЗНАЧЕНИЕ(Перечисление.СтатусыТребования.Отработано)
	|						ТОГДА ""Отработано, требует подтверждения""
	|					КОГДА ВтСтатусТребования.СтатусТребования = ЗНАЧЕНИЕ(Перечисление.СтатусыТребования.Закрыто)
	|						ТОГДА ""Закрыто""
	|					КОГДА ВтСтатусТребования.СтатусТребования = ЗНАЧЕНИЕ(Перечисление.СтатусыТребования.Отклонено)
	|						ТОГДА ""Отклонено""
	|					КОГДА ВтСтатусТребования.СтатусТребования = ЗНАЧЕНИЕ(Перечисление.СтатусыТребования.Новое)
	|						ТОГДА ""Новое""
	|					КОГДА ВтСтатусТребования.СтатусТребования = ЗНАЧЕНИЕ(Перечисление.СтатусыТребования.ПереданоВРаботу)
	|						ТОГДА ""Передано в работу""
	|					КОГДА ВтСтатусТребования.СтатусТребования = ЗНАЧЕНИЕ(Перечисление.СтатусыТребования.Уточнение)
	|						ТОГДА ""Уточнение""
	|					КОГДА ВтСтатусТребования.СтатусТребования = ЗНАЧЕНИЕ(Перечисление.СтатусыТребования.Уточнение�Предоставлено)
	|						ТОГДА ""Уточнение предоставлено""
	|					КОГДА ВтСтатусТребования.СтатусТребования = ЗНАЧЕНИЕ(Перечисление.СтатусыТребования.Перенесено)
	|						ТОГДА ""Перенесено""
	|					КОГДА ВтСтатусТребования.СтатусТребования = ЗНАЧЕНИЕ(Перечисление.СтатусыТребования.ВозвратНаДоработку)
	|						ТОГДА ""Возврат на доработку""
	|					ИНАЧЕ ВтСтатусКарточки.СтатусКарточки
	|				КОНЕЦ
	|		КОГДА ВтСтатусТребования.ДатаОтклонения ЕСТЬ НЕ NULL
	|			ТОГДА ""Отклонено""
	|		ИНАЧЕ ВтСтатусКарточки.СтатусКарточки
	|	КОНЕЦ КАК Статус,
	|	ВЫБОР
	|		КОГДА ВтДатыКарточки.ДатаВыполнено ЕСТЬ НЕ NULL ТОГДА 1
	|		КОГДА ВтСтатусТребования.ДатаОтклонения ЕСТЬ НЕ NULL ТОГДА 1
	|		КОГДА ВтСтатусТребования.ДатаЗакрытия ЕСТЬ НЕ NULL ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПорядокГруппы,
	|	Идеи.Код КАК Код,
	|	Идеи.ДатаРегистрации КАК ДатаРегистрации,
	|	ЕСТЬNULL(ВтСтатусТребования.ДатаРешения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРешения,
	|	ЕСТЬNULL(ВтСтатусТребования.ДатаЗакрытия,
	|		ЕСТЬNULL(ВтСтатусТребования.ДатаОтклонения, ДАТАВРЕМЯ(1, 1, 1))) КАК ДатаЗакрытия,
	|	Идеи.РазделПроекта КАК РазделПроекта,
	|	ПОДСТРОКА(Идеи.ПодробноеОписание, 1, 30000) КАК ПодробноеОписание,
	|	Идеи.Решение КАК Решение,
	|	Идеи.ОтветственныйОтЗаказчика КАК ОтветственныйОтЗаказчика,
	|	ВтСтатусТребования.ТипТребования КАК ТипТребования,
	|	Идеи.ОтношениеТребованийКЦелямПроекта КАК ОтношениеТребованийКЦелямПроекта,
	|	Идеи.Ответственный КАК Ответственный,
	|	ЕСТЬNULL(ВтТрудозатраты.Трудозатраты, 0) КАК Трудозатраты,
	|	// ЧТО ИЗМЕНЕНО: ссылка на требование (url, части) и код главного требования (parent, Т-76)
	|	Идеи.Ссылка КАК Требование,
	|	ЕСТЬNULL(СвязанныеТребования.ГлавноеТребование.Код, """") КАК КодГлавного,
	|	// ЧТО ИЗМЕНЕНО: ksr — крайний срок решения (v1.9)
	|	// ПОЧЕМУ: плановая дата решения ЗИ и инцидентов (в выгрузке — только инциденты)
	|	Идеи.шхКрайнийСрокРешения КАК КрайнийСрокРешения
	|ИЗ
	|	Справочник.Идеи КАК Идеи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтДатыКарточки КАК ВтДатыКарточки
	|		ПО Идеи.Ссылка = ВтДатыКарточки.Требование
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтСтатусКарточки КАК ВтСтатусКарточки
	|		ПО Идеи.Ссылка = ВтСтатусКарточки.Требование
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтСтатусТребования КАК ВтСтатусТребования
	|		ПО Идеи.Ссылка = ВтСтатусТребования.Требование
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтТрудозатраты КАК ВтТрудозатраты
	|		ПО Идеи.Ссылка = ВтТрудозатраты.Требование
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.т1кСвязанныеТребования КАК СвязанныеТребования
	|		ПО Идеи.Ссылка = СвязанныеТребования.ДочернееТребование
	|ГДЕ
	|	ВтДатыКарточки.ДатаВыполнено МЕЖДУ &ДатаЗакрытия И &ДатаЗакрытияКонец
	|	ИЛИ ВтСтатусТребования.ДатаОтклонения МЕЖДУ &ДатаЗакрытия И &ДатаЗакрытияКонец
	|	ИЛИ (ВтДатыКарточки.ДатаВыполнено ЕСТЬ NULL
	|			И ВтСтатусТребования.ДатаОтклонения ЕСТЬ NULL
	|			И ВтСтатусТребования.ДатаЗакрытия ЕСТЬ NULL)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокГруппы,
	|	ДатаРегистрации";

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда Возврат Неопределено; КонецЕсли;

	// ----------------------------------------------------------------------
	// ЧТО ИЗМЕНЕНО: результат выгружается в таблицу; табличные части собираются
	//               вторым пакетом только по попавшим в выгрузку обращениям
	// ПОЧЕМУ: необязательные части tab_* (Т-55, Т-74, Т-75, Т-77); по каждому
	//         обращению — вся история, без отсечки по дате (неделю режет ноутбук)
	// ----------------------------------------------------------------------
	Таблица = Результат.Выгрузить();
	Части = СобратьТабличныеЧасти(Запрос.МенеджерВременныхТаблиц,
		Таблица.ВыгрузитьКолонку("Требование"), ВыгружатьПереписку);

	RegExp = Неопределено;
	Попытка
		RegExp = Новый COMОбъект("VBScript.RegExp");
		RegExp.Global = Истина; RegExp.IgnoreCase = Истина; RegExp.Multiline = Истина;
	Исключение КонецПопытки;

	Поток = Новый ПотокВПамяти();
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьПоток(Поток, , , Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, " ", Истина));
	ЗаписьJSON.ЗаписатьНачалоМассива();

	// ----------------------------------------------------------------------
	// ЧТО ИЗМЕНЕНО: адрес публикации ИБ — для внешней ссылки url (v1.7)
	// ПОЧЕМУ: ссылка должна открываться по адресу публикации, как ПолучитьВнешнююСсылку; один вызов на выгрузку
	// ----------------------------------------------------------------------
	АдресПубликацииИБ = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВЛокальнойСети();

	КоличествоЗаписей   = 0;
	КоличествоЗакрытых  = 0;
	КоличествоДляСверки = 0;
	Для Каждого Выборка Из Таблица Цикл
		ТекСтатус = СокрЛП(Выборка.Статус);

		КоличествоЗаписей = КоличествоЗаписей + 1;
		Если Выборка.ПорядокГруппы = 1 Тогда
			КоличествоЗакрытых = КоличествоЗакрытых + 1;
		КонецЕсли;
		// ЧТО ИЗМЕНЕНО: отдельный счётчик для сверки со старой выгрузкой
		// ПОЧЕМУ: отклонённые тоже в закрытой ветке, а сверять надо без них
		Если ТекСтатус = "Закрыто" ИЛИ ТекСтатус = "Отработано, требует подтверждения" Тогда
			КоличествоДляСверки = КоличествоДляСверки + 1;
		КонецЕсли;

		// ЧТО ИЗМЕНЕНО: type берётся из ТипТребования регистра, с откатом на ОтношениеТребованийКЦелямПроекта
		// ПОЧЕМУ: тип обращения (инцидент и прочее) определяется реквизитом регистра
		ТекТип = СокрЛП(Строка(Выборка.ТипТребования));
		Если ПустаяСтрока(ТекТип) Тогда
			ТекТип = Строка(Выборка.ОтношениеТребованийКЦелямПроекта);
		КонецЕсли;

		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		// ЧТО ИЗМЕНЕНО: добавлены st (статус), res (дата предложенного решения) и AmountTrud
		ЗаписьJSON.ЗаписатьИмяСвойства("st");   ЗаписьJSON.ЗаписатьЗначение(ТекСтатус);
		ЗаписьJSON.ЗаписатьИмяСвойства("id");   ЗаписьJSON.ЗаписатьЗначение(СокрЛП(Выборка.Код));
		ЗаписьJSON.ЗаписатьИмяСвойства("reg");  ЗаписьJSON.ЗаписатьЗначение(ДатаВJSON(Выборка.ДатаРегистрации));
		ЗаписьJSON.ЗаписатьИмяСвойства("res");  ЗаписьJSON.ЗаписатьЗначение(ДатаВJSON(Выборка.ДатаРешения));
		ЗаписьJSON.ЗаписатьИмяСвойства("cls");  ЗаписьJSON.ЗаписатьЗначение(ДатаВJSON(Выборка.ДатаЗакрытия));
		ЗаписьJSON.ЗаписатьИмяСвойства("sec");  ЗаписьJSON.ЗаписатьЗначение(Строка(Выборка.РазделПроекта));
		ЗаписьJSON.ЗаписатьИмяСвойства("desc"); ЗаписьJSON.ЗаписатьЗначение(ОчиститьТекстRegExp(Выборка.ПодробноеОписание, RegExp));
		ЗаписьJSON.ЗаписатьИмяСвойства("sol");  ЗаписьJSON.ЗаписатьЗначение(ОчиститьТекстRegExp(Выборка.Решение, RegExp));
		ЗаписьJSON.ЗаписатьИмяСвойства("anl");  ЗаписьJSON.ЗаписатьЗначение(Строка(Выборка.Ответственный));
		ЗаписьJSON.ЗаписатьИмяСвойства("cli");  ЗаписьJSON.ЗаписатьЗначение(Строка(Выборка.ОтветственныйОтЗаказчика));
		// ----------------------------------------------------------------------
		// ЧТО ИЗМЕНЕНО: ksr — крайний срок решения (v1.9)
		// ПОЧЕМУ: плановая дата решения ЗИ и инцидентов; в выгрузке ЗИ нет, поэтому заполнен у инцидентов.
		//         Пустая дата — пустая строка (как у остальных дат)
		// ----------------------------------------------------------------------
		ЗаписьJSON.ЗаписатьИмяСвойства("ksr");  ЗаписьJSON.ЗаписатьЗначение(ДатаВJSON(Выборка.КрайнийСрокРешения));
		// ----------------------------------------------------------------------
		// ЧТО ИЗМЕНЕНО: cli_id, anl_id — идентификаторы инициатора и ответственного
		// ПОЧЕМУ: склейка написаний одного человека и замена ФИО для ИИ (Т-69); в отчёте — ФИО
		// ----------------------------------------------------------------------
		ЗаписатьНепустое(ЗаписьJSON, "cli_id", ИдентификаторСсылки(Выборка.ОтветственныйОтЗаказчика));
		ЗаписатьНепустое(ЗаписьJSON, "anl_id", ИдентификаторСсылки(Выборка.Ответственный));
		ЗаписьJSON.ЗаписатьИмяСвойства("type"); ЗаписьJSON.ЗаписатьЗначение(ТекТип);
		ЗаписьJSON.ЗаписатьИмяСвойства("AmountTrud"); ЗаписьJSON.ЗаписатьЗначение(Выборка.Трудозатраты);
		// ----------------------------------------------------------------------
		// ЧТО ИЗМЕНЕНО: url (Т-57), parent (Т-76) и необязательные табличные части
		// ПОЧЕМУ: новые данные — дополнение для сравнения (my-FT Р-9); нет строк — поле не пишется
		// ----------------------------------------------------------------------
		ЗаписатьНепустое(ЗаписьJSON, "url", АдресПубликацииИБ + "#" + ПолучитьНавигационнуюСсылку(Выборка.Требование));
		ЗаписатьНепустое(ЗаписьJSON, "parent", СокрЛП(Выборка.КодГлавного));
		Для Каждого Часть Из Части Цикл
			ЗаписатьЧасть(ЗаписьJSON, Часть.Ключ, Часть.Значение.Получить(Выборка.Требование));
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецОбъекта();
	КонецЦикла;

	ЗаписьJSON.ЗаписатьКонецМассива();
	ЗаписьJSON.Закрыть();

	Возврат Новый Структура("Данные, Количество, КоличествоЗакрытых, КоличествоДляСверки",
		Поток.ЗакрытьИПолучитьДвоичныеДанные(), КоличествоЗаписей, КоличествоЗакрытых, КоличествоДляСверки);
КонецФункции


// ----------------------------------------------------------------------
// ЧТО ИЗМЕНЕНО: новые служебные функции v1.5
// ПОЧЕМУ: табличные части tab_* и необязательные поля
// ----------------------------------------------------------------------

// Возвращает Соответствие: имя части → Соответствие(Требование → Массив строк; строка — Массив значений).
&НаСервереБезКонтекста
Функция СобратьТабличныеЧасти(МенеджерВТ, Требования, ВыгружатьПереписку)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Требования", Требования);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВтИдеи.Требование КАК Требование,
	|	ВтИдеи.Карточка КАК Карточка
	|ПОМЕСТИТЬ ВтВыгрузка
	|ИЗ
	|	ВтИдеи КАК ВтИдеи
	|ГДЕ
	|	ВтИдеи.Требование В (&Требования)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Требование,
	|	Карточка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// tab_trud: [исполнитель, часы] — ЧасыФактПоКарточкам по исполнителям
	|ВЫБРАТЬ
	|	ВтВыгрузка.Требование КАК Требование,
	|	ПРЕДСТАВЛЕНИЕ(ЧасыПоКарточкам.Исполнитель) КАК Исполнитель,
	|	СУММА(ЧасыПоКарточкам.ЧасыФакт) КАК Часы
	|ИЗ
	|	ВтВыгрузка КАК ВтВыгрузка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЧасыФактПоКарточкам КАК ЧасыПоКарточкам
	|		ПО ВтВыгрузка.Карточка = ЧасыПоКарточкам.Карточка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтВыгрузка.Требование,
	|	ЧасыПоКарточкам.Исполнитель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// tab_status: [дата, кто сменил, регистр, статус] — карточка и требование, по возрастанию даты
	|ВЫБРАТЬ
	|	ВтВыгрузка.Требование КАК Требование,
	|	ИсторияКарточек.Период КАК Период,
	|	ПРЕДСТАВЛЕНИЕ(ИсторияКарточек.Автор) КАК Кто,
	|	""карточка"" КАК Регистр,
	|	ПРЕДСТАВЛЕНИЕ(ИсторияКарточек.Статус) КАК Статус
	|ИЗ
	|	ВтВыгрузка КАК ВтВыгрузка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияСтатусовКарточек КАК ИсторияКарточек
	|		ПО ВтВыгрузка.Карточка = ИсторияКарточек.Карточка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВтВыгрузка.Требование,
	|	ИсторияТребований.Период,
	|	ПРЕДСТАВЛЕНИЕ(ИсторияТребований.Пользователь),
	|	""требование"",
	|	ПРЕДСТАВЛЕНИЕ(ИсторияТребований.СтатусОбработкиТребований)
	|ИЗ
	|	ВтВыгрузка КАК ВтВыгрузка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияИзмененияТребований КАК ИсторияТребований
	|		ПО ВтВыгрузка.Требование = ИсторияТребований.Идея
	|
	|УПОРЯДОЧИТЬ ПО
	|	Требование,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// tab_sla: [дата, статус, секунд, пауза, дата смены статуса] — расчёт времени из 1С (Т-74)
	|ВЫБРАТЬ
	|	ВтВыгрузка.Требование КАК Требование,
	|	РасчетВремени.Период КАК Период,
	|	ПРЕДСТАВЛЕНИЕ(РасчетВремени.Статус) КАК Статус,
	|	РасчетВремени.СекундВыполнения КАК СекундВыполнения,
	|	РасчетВремени.ЭтоПауза КАК ЭтоПауза,
	|	РасчетВремени.ДатаСменыСтатуса КАК ДатаСменыСтатуса
	|ИЗ
	|	ВтВыгрузка КАК ВтВыгрузка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.т1кРасчетВремениВыполненияКарточки КАК РасчетВремени
	|		ПО ВтВыгрузка.Карточка = РасчетВремени.Карточка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Требование,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// tab_rate: [дата, оценка, заявитель, ответственный, комментарий] — оценки пользователей (Т-77)
	|ВЫБРАТЬ
	|	ВтВыгрузка.Требование КАК Требование,
	|	Оценки.Период КАК Период,
	|	ПРЕДСТАВЛЕНИЕ(Оценки.Оценка) КАК Оценка,
	|	ПРЕДСТАВЛЕНИЕ(Оценки.Заявитель) КАК Заявитель,
	|	ПРЕДСТАВЛЕНИЕ(Оценки.Ответственный) КАК Ответственный,
	|	Оценки.Комментарий КАК Комментарий
	|ИЗ
	|	ВтВыгрузка КАК ВтВыгрузка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.шхОценкиТребований КАК Оценки
	|		ПО ВтВыгрузка.Требование = Оценки.Требование
	|
	|УПОРЯДОЧИТЬ ПО
	|	Требование,
	|	Период";

	Пакет = Запрос.ВыполнитьПакет();
	Части = Новый Соответствие;
	Части.Вставить("tab_trud",   СгруппироватьПоТребованию(Пакет[1], "Исполнитель,Часы"));
	Части.Вставить("tab_status", СгруппироватьПоТребованию(Пакет[2], "Период,Кто,Регистр,Статус"));
	Части.Вставить("tab_sla",    СгруппироватьПоТребованию(Пакет[3], "Период,Статус,СекундВыполнения,ЭтоПауза,ДатаСменыСтатуса"));
	Части.Вставить("tab_rate",   СгруппироватьПоТребованию(Пакет[4], "Период,Оценка,Заявитель,Ответственный,Комментарий"));

	Если ВыгружатьПереписку Тогда
		// tab_chat: [дата, автор, текст] — переписка по карточке и по требованию (Т-75, для информации)
		ЗапросПереписки = Новый Запрос;
		ЗапросПереписки.МенеджерВременныхТаблиц = МенеджерВТ;
		ЗапросПереписки.Текст =
		"ВЫБРАТЬ
		|	ВтВыгрузка.Требование КАК Требование,
		|	Переписка.ДатаДобавления КАК ДатаДобавления,
		|	ПРЕДСТАВЛЕНИЕ(Переписка.Пользователь) КАК Автор,
		|	Переписка.Комментарий КАК Текст
		|ИЗ
		|	ВтВыгрузка КАК ВтВыгрузка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.т1кПерепискаВКарточках КАК Переписка
		|		ПО ВтВыгрузка.Карточка = Переписка.Объект
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВтВыгрузка.Требование,
		|	Переписка.ДатаДобавления,
		|	ПРЕДСТАВЛЕНИЕ(Переписка.Пользователь),
		|	Переписка.Комментарий
		|ИЗ
		|	ВтВыгрузка КАК ВтВыгрузка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.т1кПерепискаВКарточках КАК Переписка
		|		ПО ВтВыгрузка.Требование = Переписка.Объект
		|
		|УПОРЯДОЧИТЬ ПО
		|	Требование,
		|	ДатаДобавления";
		Части.Вставить("tab_chat", СгруппироватьПоТребованию(ЗапросПереписки.Выполнить(), "ДатаДобавления,Автор,Текст"));
	КонецЕсли;

	Возврат Части;
КонецФункции

// Результат запроса с колонкой Требование → Соответствие(Требование → Массив строк).
&НаСервереБезКонтекста
Функция СгруппироватьПоТребованию(РезультатЗапроса, Колонки)
	Итог = Новый Соответствие;
	Имена = СтрРазделить(Колонки, ",");
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки = Итог.Получить(Выборка.Требование);
		Если Строки = Неопределено Тогда
			Строки = Новый Массив;
			Итог.Вставить(Выборка.Требование, Строки);
		КонецЕсли;
		СтрокаЧасти = Новый Массив;
		Для Каждого Имя Из Имена Цикл
			СтрокаЧасти.Добавить(Выборка[Имя]);
		КонецЦикла;
		Строки.Добавить(СтрокаЧасти);
	КонецЦикла;
	Возврат Итог;
КонецФункции

// Пишет часть массивом массивов; нет строк — поле не пишется.
&НаСервереБезКонтекста
Процедура ЗаписатьЧасть(ЗаписьJSON, ИмяПоля, Строки)
	Если Строки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаписьJSON.ЗаписатьИмяСвойства(ИмяПоля);
	ЗаписьJSON.ЗаписатьНачалоМассива();
	Для Каждого СтрокаЧасти Из Строки Цикл
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Значение Из СтрокаЧасти Цикл
			ТипЗначения = ТипЗнч(Значение);
			Если Значение = Null Тогда
				ЗаписьJSON.ЗаписатьЗначение("");
			ИначеЕсли ТипЗначения = Тип("Дата") Тогда
				ЗаписьJSON.ЗаписатьЗначение(ДатаВJSON(Значение));
			ИначеЕсли ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Или ТипЗначения = Тип("Строка") Тогда
				ЗаписьJSON.ЗаписатьЗначение(Значение);
			Иначе
				ЗаписьJSON.ЗаписатьЗначение(Строка(Значение));
			КонецЕсли;
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
	КонецЦикла;
	ЗаписьJSON.ЗаписатьКонецМассива();
КонецПроцедуры

// Пишет строковое поле, только если значение не пустое.
&НаСервереБезКонтекста
Процедура ЗаписатьНепустое(ЗаписьJSON, ИмяПоля, Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства(ИмяПоля);
		ЗаписьJSON.ЗаписатьЗначение(Значение);
	КонецЕсли;
КонецПроцедуры

// Уникальный идентификатор ссылки строкой; пустая ссылка или не ссылка — "".
&НаСервереБезКонтекста
Функция ИдентификаторСсылки(Ссылка)
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Строка(Ссылка.УникальныйИдентификатор());
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции
