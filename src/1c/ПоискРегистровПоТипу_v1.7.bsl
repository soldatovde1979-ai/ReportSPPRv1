// ПоискРегистровПоТипу v1.7
// Внешняя обработка, модуль управляемой формы.
// Что делает: по выбранному типу находит регистры сведений и накопления, у которых
// этот тип есть в измерении, и выводит ВСЕ поля этих регистров с типами и счётчиками записей.
//
// Сборка (конфигуратор): внешняя обработка → форма → реквизиты формы
//   ИмяТипа (Строка, 200), Результат (ТабличныйДокумент), ПосчитатьЗаписи (Булево);
//   команда Выполнить (Действие = ВыполнитьКоманду) → кнопкой на форму;
//   свойства формы → События → ПриСозданииНаСервере = существующая процедура.
// Поля ИмяТипа, ПосчитатьЗаписи, Результат создаются кодом ниже.
// Побочных эффектов нет: только чтение метаданных и запросы ВЫБРАТЬ.
//
// v1.7 (05.10.2026): ИмяТипа по умолчанию — "СправочникСсылка.Идеи";
//   ПериодичностьРегистраСведений вместо Периодичность; РежимЗаписиРегистра.ПодчинениеРегистратору.
// Результаты прогонов — docs/1c_registers_scan.md.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИмяТипа = "СправочникСсылка.Идеи";
	ПосчитатьЗаписи = Истина;

	ПолеТипа = Элементы.Добавить("ИмяТипа", Тип("ПолеФормы"));
	ПолеТипа.Вид = ВидПоляФормы.ПолеВвода;
	ПолеТипа.ПутьКДанным = "ИмяТипа";
	ПолеТипа.Заголовок = "Искомый тип";
	ПолеТипа.РежимВыбораИзСписка = Истина;
	ЗаполнитьСписокТипов(ПолеТипа.СписокВыбора);

	ПолеСчёта = Элементы.Добавить("ПосчитатьЗаписи", Тип("ПолеФормы"));
	ПолеСчёта.Вид = ВидПоляФормы.ПолеФлажка;
	ПолеСчёта.ПутьКДанным = "ПосчитатьЗаписи";
	ПолеСчёта.Заголовок = "Считать записи (дольше на больших регистрах)";

	ПолеРезультата = Элементы.Добавить("Результат", Тип("ПолеФормы"));
	ПолеРезультата.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
	ПолеРезультата.ПутьКДанным = "Результат";
	ПолеРезультата.Заголовок = "Результат";

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКоманду(Команда)
	Сформировать();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокТипов(Список)
	// Ссылочные типы всех видов объектов: "СправочникСсылка.Идеи" и т.п.
	Группы = Новый Соответствие;
	Группы.Вставить("СправочникСсылка", Метаданные.Справочники);
	Группы.Вставить("ДокументСсылка", Метаданные.Документы);
	Группы.Вставить("ПеречислениеСсылка", Метаданные.Перечисления);
	Группы.Вставить("ПланВидовХарактеристикСсылка", Метаданные.ПланыВидовХарактеристик);
	Группы.Вставить("ПланСчетовСсылка", Метаданные.ПланыСчетов);
	Группы.Вставить("ПланВидовРасчетаСсылка", Метаданные.ПланыВидовРасчета);
	Группы.Вставить("БизнесПроцессСсылка", Метаданные.БизнесПроцессы);
	Группы.Вставить("ЗадачаСсылка", Метаданные.Задачи);
	Для Каждого Группа Из Группы Цикл
		Для Каждого ОбъектМД Из Группа.Значение Цикл
			Список.Добавить(Группа.Ключ + "." + ОбъектМД.Имя);
		КонецЦикла;
	КонецЦикла;
	Список.СортироватьПоЗначению();
КонецПроцедуры

&НаСервере
Функция ОписатьТип(ОписаниеТипа)
	// "Справочник.Идеи, Строка(100), Число(15,2)" — через запятую, составной тип целиком.
	Части = Новый Массив;
	Для Каждого Т Из ОписаниеТипа.Типы() Цикл
		ОбъектМД = Метаданные.НайтиПоТипу(Т);
		Если ОбъектМД <> Неопределено Тогда
			Части.Добавить(ОбъектМД.ПолноеИмя());
		ИначеЕсли Т = Тип("Строка") Тогда
			Части.Добавить("Строка(" + ?(ОписаниеТипа.КвалификаторыСтроки.Длина = 0, "неогр.", Формат(ОписаниеТипа.КвалификаторыСтроки.Длина, "ЧГ=0")) + ")");
		ИначеЕсли Т = Тип("Число") Тогда
			Части.Добавить("Число(" + Формат(ОписаниеТипа.КвалификаторыЧисла.Разрядность, "ЧГ=0") + "," + Формат(ОписаниеТипа.КвалификаторыЧисла.РазрядностьДробнойЧасти, "ЧГ=0") + ")");
		ИначеЕсли Т = Тип("Дата") Тогда
			Части.Добавить("Дата(" + ОписаниеТипа.КвалификаторыДаты.ЧастиДаты + ")");
		Иначе
			Части.Добавить(Строка(Т));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");
КонецФункции

&НаСервере
Процедура ВывестиПоля(Строки, Коллекция, Роль, ИскомыйТип, ЭтоПоискИзмерения)
	Для Каждого Поле Из Коллекция Цикл
		Совпадает = ЭтоПоискИзмерения И Поле.Тип.СодержитТип(ИскомыйТип);
		Строки.Добавить(Новый Структура("Роль,Имя,Синоним,Тип,Совпадает", Роль, Поле.Имя, Поле.Синоним, ОписатьТип(Поле.Тип), Совпадает));
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПосчитатьПоРегистру(Регистр, ИскомыйТип)
	// Возвращает Структуру: Всего, Ошибка, ПоИзмерениям (Соответствие: имя измерения → Структура(СИскомым, Различных)).
	// Один запрос на регистр, один проход по таблице.
	Итог = Новый Структура("Всего,Ошибка,ПоИзмерениям", 0, "", Новый Соответствие);
	ТипМД = Метаданные.НайтиПоТипу(ИскомыйТип);

	Совпавшие = Новый Массив;
	Для Каждого Измерение Из Регистр.Измерения Цикл
		Если Измерение.Тип.СодержитТип(ИскомыйТип) Тогда
			Совпавшие.Добавить(Измерение.Имя);
		КонецЕсли;
	КонецЦикла;

	Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего";
	Н = 0;
	Для Каждого Имя Из Совпавшие Цикл
		Если ТипМД <> Неопределено Тогда
			// Только значения именно искомого типа (измерение может быть составным)
			Текст = Текст + ", КОЛИЧЕСТВО(ВЫБОР КОГДА Т." + Имя + " ССЫЛКА " + ТипМД.ПолноеИмя() + " ТОГДА 1 КОНЕЦ) КАК С" + Н
				+ ", КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР КОГДА Т." + Имя + " ССЫЛКА " + ТипМД.ПолноеИмя() + " ТОГДА Т." + Имя + " КОНЕЦ) КАК Р" + Н;
		КонецЕсли;
		Н = Н + 1;
	КонецЦикла;
	Текст = Текст + " ИЗ " + Регистр.ПолноеИмя() + " КАК Т";

	Попытка
		Запрос = Новый Запрос(Текст);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Итог.Всего = Выборка.Всего;
		Если ТипМД <> Неопределено Тогда
			Н = 0;
			Для Каждого Имя Из Совпавшие Цикл
				Итог.ПоИзмерениям.Вставить(Имя, Новый Структура("СИскомым,Различных", Выборка["С" + Н], Выборка["Р" + Н]));
				Н = Н + 1;
			КонецЦикла;
		КонецЕсли;
	Исключение
		Итог.Ошибка = "ошибка запроса: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Итог;
КонецФункции

&НаСервере
Процедура Сформировать()

	Результат.Очистить();

	Попытка
		ИскомыйТип = Тип(ИмяТипа);
	Исключение
		Сообщить("Тип не найден: " + ИмяТипа);
		Возврат;
	КонецПопытки;

	// Заголовок таблицы
	Заголовки = СтрРазделить("Вид регистра;Регистр;Синоним регистра;Вид/периодичность;Роль поля;Поле;Синоним поля;Тип поля;Искомый тип в измерении;Записей в регистре;Записей с искомым типом;Различных значений искомого типа", ";");
	Для Н = 0 По Заголовки.ВГраница() Цикл
		Результат.Область(1, Н + 1).Текст = Заголовки[Н];
		Результат.Область(1, Н + 1).Шрифт = Новый Шрифт(, , Истина);
	КонецЦикла;

	НомерСтроки = 2;
	Найдено = 0;

	// Два вида регистров обрабатываются одним кодом: (коллекция, подпись)
	Виды = Новый Массив;
	Виды.Добавить(Новый Структура("Коллекция,Подпись", Метаданные.РегистрыСведений, "Регистр сведений"));
	Виды.Добавить(Новый Структура("Коллекция,Подпись", Метаданные.РегистрыНакопления, "Регистр накопления"));

	Для Каждого Вид Из Виды Цикл
		Для Каждого Регистр Из Вид.Коллекция Цикл

			// Совпадение — только по ИЗМЕРЕНИЯМ
			Подходит = Ложь;
			Для Каждого Измерение Из Регистр.Измерения Цикл
				Если Измерение.Тип.СодержитТип(ИскомыйТип) Тогда
					Подходит = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не Подходит Тогда
				Продолжить;
			КонецЕсли;
			Найдено = Найдено + 1;

			// Свойство «вид» у двух регистров называется по-разному
			Если Вид.Подпись = "Регистр сведений" Тогда
				ВидРегистра = "период: " + Строка(Регистр.ПериодичностьРегистраСведений) + ?(Регистр.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору, ", подчинён регистратору", "");
			Иначе
				ВидРегистра = Строка(Регистр.ВидРегистра);
			КонецЕсли;

			Поля = Новый Массив;
			ВывестиПоля(Поля, Регистр.Измерения, "Измерение", ИскомыйТип, Истина);
			ВывестиПоля(Поля, Регистр.Ресурсы, "Ресурс (значение)", ИскомыйТип, Ложь);
			ВывестиПоля(Поля, Регистр.Реквизиты, "Реквизит", ИскомыйТип, Ложь);
			ВывестиПоля(Поля, Регистр.СтандартныеРеквизиты, "Станд. реквизит", ИскомыйТип, Ложь);

			Счёт = Неопределено;
			Если ПосчитатьЗаписи Тогда
				Счёт = ПосчитатьПоРегистру(Регистр, ИскомыйТип);
			КонецЕсли;
			ПерваяСтрокаРегистра = Истина;

			Для Каждого Поле Из Поля Цикл
				Результат.Область(НомерСтроки, 1).Текст = Вид.Подпись;
				Результат.Область(НомерСтроки, 2).Текст = Регистр.Имя;
				Результат.Область(НомерСтроки, 3).Текст = Регистр.Синоним;
				Результат.Область(НомерСтроки, 4).Текст = ВидРегистра;
				Результат.Область(НомерСтроки, 5).Текст = Поле.Роль;
				Результат.Область(НомерСтроки, 6).Текст = Поле.Имя;
				Результат.Область(НомерСтроки, 7).Текст = Поле.Синоним;
				Результат.Область(НомерСтроки, 8).Текст = Поле.Тип;
				Результат.Область(НомерСтроки, 9).Текст = ?(Поле.Совпадает, "ДА", "");
				Если Счёт <> Неопределено Тогда
					Если ПерваяСтрокаРегистра Тогда
						Результат.Область(НомерСтроки, 10).Текст = ?(ЗначениеЗаполнено(Счёт.Ошибка), Счёт.Ошибка, Формат(Счёт.Всего, "ЧГ=0"));
						ПерваяСтрокаРегистра = Ложь;
					КонецЕсли;
					Если Поле.Совпадает И Не ЗначениеЗаполнено(Счёт.Ошибка) И Счёт.ПоИзмерениям[Поле.Имя] <> Неопределено Тогда
						Результат.Область(НомерСтроки, 11).Текст = Формат(Счёт.ПоИзмерениям[Поле.Имя].СИскомым, "ЧГ=0");
						Результат.Область(НомерСтроки, 12).Текст = Формат(Счёт.ПоИзмерениям[Поле.Имя].Различных, "ЧГ=0");
					КонецЕсли;
				КонецЕсли;
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;

		КонецЦикла;
	КонецЦикла;

	Сообщить("Тип " + ИмяТипа + ": регистров найдено " + Найдено + ", строк в таблице " + (НомерСтроки - 2));

КонецПроцедуры
